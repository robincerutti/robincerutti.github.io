        <div id="slide-caption"></div>
      </div>
    </div>

    <div id="view-text"></div>
  </div>
</div>

<!-- SEO snapshot: pre-rendered HTML for search crawlers -->
<div id="seo-snapshot">
  <h1>{section.label}</h1>
  {section.description && <p>{section.description.replace(/\[video:[^\]]+\]/gi, '').trim()}</p>}
  {allPhotos.map(p => (
    <img src={`/${p.url}`} alt={p.caption || section.label} loading="lazy" width="800" />
  ))}
  {section.blocks && section.blocks.filter(b => b.type === 'text').map(b => (
    <p>{b.content}</p>
  ))}
</div>

<script is:inline>
// ════════════════════════════════════════════════════
//  STATE
// ════════════════════════════════════════════════════
let DATA = null;
let MANIFEST = null;
let allSections = [];
let curSection = null;
let curPhotos = [];
let curPhotoIdx = 0;
let viewMode = 'slide';
let expandedGroup = null;

function isMobile() { return window.innerWidth <= 640; }

// ════════════════════════════════════════════════════
//  URL ↔ SECTION
// ════════════════════════════════════════════════════
function sectionToUrl(s) {
  if (s.id === 'main') return '/';
  if (!s.group) return '/' + s.id.toLowerCase().replace(/\s+/g, '-') + '/';
  const g = s.group.toLowerCase();
  const sub = s.id.slice(g.length + 1);
  return '/' + g + '/' + sub.toLowerCase().replace(/\s+/g, '-') + '/';
}

function urlToSectionId(path) {
  if (path === '/') return 'main';
  for (const s of allSections) {
    if (sectionToUrl(s) === path) return s.id;
  }
  return null;
}

// ════════════════════════════════════════════════════
//  LOAD DATA
// ════════════════════════════════════════════════════
async function init() {
  try {
    const [dataRes, manifestRes, infoRes] = await Promise.all([
      fetch('/data.json'),
      fetch('/manifest.json'),
      fetch('/info.txt')
    ]);
    DATA = await dataRes.json();
    MANIFEST = await manifestRes.json();
    if (infoRes.ok) DATA.infoText = (await infoRes.text()).replace(/\n/g, '<br>');
    // Prefix relative photo URLs with "/" (manifest uses relative paths, v2 needs absolute)
    for (const s of MANIFEST.sections || []) {
      if (s.photos) s.photos.forEach(p => { if (!p.url.startsWith('/') && !p.url.startsWith('http')) p.url = '/' + p.url; });
      if (s.blocks) s.blocks.forEach(b => {
        if (b.type === 'gallery') b.photos.forEach(p => { if (!p.url.startsWith('/') && !p.url.startsWith('http')) p.url = '/' + p.url; });
      });
    }
  } catch (e) {
    console.error('Failed to load data:', e);
    document.getElementById('loading').textContent = 'erreur de chargement';
    return;
  }

  allSections = [
    ...(MANIFEST.sections || []),
    ...(DATA.extraSections || [])
  ];

  document.getElementById('site-name').innerHTML = DATA.name.replace(/\n/g, '<br>');
  document.getElementById('copyright').innerHTML = `<span style="font-family:sans-serif;">©</span> Robin Cerutti ${new Date().getFullYear()}`;
  renderNav();

  if (localStorage.getItem('rc-theme') !== 'dark') {
    document.body.classList.add('light');
    document.getElementById('theme-btn').textContent = 'light';
  }

  viewMode = 'grid';
  const sectionId = urlToSectionId(window.location.pathname) || 'main';
  selectSection(sectionId);

  setTimeout(() => document.getElementById('loading').classList.add('done'), 200);
}

// ════════════════════════════════════════════════════
//  MOBILE SHELL STATE
// ════════════════════════════════════════════════════
function updateMobileShell() {}

// ════════════════════════════════════════════════════
//  MOBILE FULLSCREEN
// ════════════════════════════════════════════════════
let fsActive = 'a';
let fsStartX = 0, fsStartY = 0, fsDragging = false, fsLocked = false, fsPendingDir = 0;
let fsScale = 1, fsPanX = 0, fsPanY = 0, fsPanStartX = 0, fsPanStartY = 0;
let fsZooming = false, fsInitDist = 0, fsInitScale = 1, fsInitPinchX = 0, fsInitPinchY = 0, fsInitPanX = 0, fsInitPanY = 0;
let fsLastTap = 0;

function fsSlot(s) { return document.getElementById(`mobile-fs-slot-${s}`); }
function fsImg(s)  { return document.getElementById(`mobile-fs-img-${s}`); }
function fsOther() { return fsActive === 'a' ? 'b' : 'a'; }

function fsDist(t) {
  const dx = t[0].clientX - t[1].clientX, dy = t[0].clientY - t[1].clientY;
  return Math.sqrt(dx * dx + dy * dy);
}

function applyZoom(slot) {
  fsImg(slot).style.transform = `translate(${fsPanX}px, ${fsPanY}px) scale(${fsScale})`;
}

function resetZoom(slot, animate) {
  const img = fsImg(slot);
  img.style.transition = animate ? 'transform .25s ease' : 'none';
  img.style.transform = '';
  fsScale = 1; fsPanX = 0; fsPanY = 0;
}

function openMobileFS(idx) {
  curPhotoIdx = idx;
  const photos = curPhotos;
  const p = photos[idx];
  if (!p) return;
  fsActive = 'a';
  fsScale = 1; fsPanX = 0; fsPanY = 0;
  fsImg('a').src = p.url;
  fsImg('a').style.transition = 'none';
  fsImg('a').style.transform = '';
  fsSlot('a').style.transition = 'none';
  fsSlot('a').style.transform = 'translateX(0)';
  fsImg('b').src = '';
  fsImg('b').style.transform = '';
  fsSlot('b').style.transform = `translateX(${window.innerWidth}px)`;
  document.getElementById('mobile-fs-counter').textContent = `${idx + 1} / ${photos.length}`;
  document.getElementById('mobile-fs-caption').textContent = photos[idx].caption || '';
  document.getElementById('mobile-fs').classList.add('open');
}

function closeMobileFS() {
  document.getElementById('mobile-fs').classList.remove('open');
  resetZoom(fsActive, false);
}

function navigateMobileFS(dir) {
  const photos = curPhotos;
  if (!photos.length) return;
  curPhotoIdx = (curPhotoIdx + dir + photos.length) % photos.length;
  resetZoom(fsActive, false);
  fsImg(fsActive).src = photos[curPhotoIdx].url;
  document.getElementById('mobile-fs-counter').textContent = `${curPhotoIdx + 1} / ${photos.length}`;
  document.getElementById('mobile-fs-caption').textContent = photos[curPhotoIdx].caption || '';
}

// ── Fullscreen touch handling ──
const fsEl = document.getElementById('mobile-fs');

fsEl.addEventListener('touchstart', e => {
  const now = Date.now();
  if (e.touches.length === 1 && now - fsLastTap < 280) {
    if (fsScale > 1) {
      resetZoom(fsActive, true);
    } else {
      const tapX = e.touches[0].clientX;
      const tapY = e.touches[0].clientY;
      fsScale = 2.5;
      fsPanX = (window.innerWidth / 2 - tapX) * (fsScale - 1);
      fsPanY = (window.innerHeight / 2 - tapY) * (fsScale - 1);
      fsImg(fsActive).style.transition = 'transform 0.25s ease';
      applyZoom(fsActive);
    }
    fsLastTap = 0;
    return;
  }
  if (e.touches.length === 1) fsLastTap = now;

  if (e.touches.length === 2) {
    fsDragging = false;
    fsZooming = true;
    fsInitDist = fsDist(e.touches);
    fsInitScale = fsScale;
    fsInitPanX = fsPanX; fsInitPanY = fsPanY;
    fsInitPinchX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
    fsInitPinchY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
    fsImg(fsActive).style.transition = 'none';
    return;
  }

  if (fsLocked || fsZooming) return;
  fsStartX = e.touches[0].clientX;
  fsStartY = e.touches[0].clientY;
  fsPanStartX = fsPanX; fsPanStartY = fsPanY;
  fsDragging = false; fsPendingDir = 0;
  if (fsScale === 1) fsSlot(fsActive).style.transition = 'none';
}, { passive: true });

fsEl.addEventListener('touchmove', e => {
  if (e.touches.length === 2 && fsZooming) {
    const ratio = fsDist(e.touches) / fsInitDist;
    fsScale = Math.max(1, Math.min(4, fsInitScale * ratio));
    const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
    const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
    fsPanX = fsInitPanX + (midX - fsInitPinchX);
    fsPanY = fsInitPanY + (midY - fsInitPinchY);
    applyZoom(fsActive);
    return;
  }

  if (fsLocked || fsZooming || e.touches.length !== 1) return;
  const dx = e.touches[0].clientX - fsStartX;
  const dy = e.touches[0].clientY - fsStartY;

  if (fsScale > 1) {
    fsPanX = fsPanStartX + dx;
    fsPanY = fsPanStartY + dy;
    applyZoom(fsActive);
    return;
  }

  if (!fsDragging && Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
    fsDragging = true;
    fsPendingDir = dx < 0 ? 1 : -1;
    const photos = curPhotos;
    const nextIdx = (curPhotoIdx + fsPendingDir + photos.length) % photos.length;
    const other = fsOther();
    fsImg(other).style.transition = 'none';
    fsImg(other).src = photos[nextIdx].url;
    fsSlot(other).style.transition = 'none';
    fsSlot(other).style.transform = `translateX(${fsPendingDir * window.innerWidth}px)`;
  }
  if (fsDragging) {
    const W = window.innerWidth;
    fsSlot(fsActive).style.transform = `translateX(${dx}px)`;
    fsSlot(fsOther()).style.transform = `translateX(${fsPendingDir * W + dx}px)`;
  }
}, { passive: true });

fsEl.addEventListener('touchend', e => {
  if (fsZooming && e.touches.length < 2) {
    fsZooming = false;
    if (fsScale < 1.05) resetZoom(fsActive, true);
    return;
  }

  if (fsLocked || fsZooming) return;
  if (fsScale > 1) return;

  const dx = e.changedTouches[0].clientX - fsStartX;
  const dy = e.changedTouches[0].clientY - fsStartY;

  const W = window.innerWidth;
  const cur = fsActive, nxt = fsOther();

  if (!fsDragging || Math.abs(dx) < 60) {
    fsSlot(cur).style.transition = 'transform .2s ease';
    fsSlot(cur).style.transform = 'translateX(0)';
    if (fsPendingDir !== 0) {
      fsSlot(nxt).style.transition = 'transform .2s ease';
      fsSlot(nxt).style.transform = `translateX(${fsPendingDir * W}px)`;
    }
    return;
  }

  fsLocked = true;
  const dir = fsPendingDir;
  fsSlot(cur).style.transition = 'transform .22s ease';
  fsSlot(cur).style.transform = `translateX(${-dir * W}px)`;
  fsSlot(nxt).style.transition = 'transform .22s ease';
  fsSlot(nxt).style.transform = 'translateX(0)';

  setTimeout(() => {
    const photos = curPhotos;
    curPhotoIdx = (curPhotoIdx + dir + photos.length) % photos.length;
    document.getElementById('mobile-fs-counter').textContent = `${curPhotoIdx + 1} / ${photos.length}`;
    document.getElementById('mobile-fs-caption').textContent = photos[curPhotoIdx].caption || '';
    fsActive = nxt;
    fsSlot(cur).style.transition = 'none';
    fsSlot(cur).style.transform = `translateX(${dir * W}px)`;
    fsImg(cur).style.transform = '';
    fsScale = 1; fsPanX = 0; fsPanY = 0;
    fsLocked = false; fsPendingDir = 0;
  }, 220);
}, { passive: true });

// ── Swipe up to close (listener indépendant) ──
let _swipeStartY = 0, _swipeStartX = 0;
fsEl.addEventListener('touchstart', e => {
  if (e.touches.length === 1) { _swipeStartY = e.touches[0].clientY; _swipeStartX = e.touches[0].clientX; }
}, { passive: true });
fsEl.addEventListener('touchend', e => {
  if (fsScale > 1 || fsZooming || fsLocked) return;
  const endY = e.changedTouches[0].clientY;
  const endX = e.changedTouches[0].clientX;
  const dy = endY - _swipeStartY;
  const dx = endX - _swipeStartX;
  if (dy < -120 && Math.abs(dy) > Math.abs(dx) * 1.2) closeMobileFS();
}, { passive: true });

// ════════════════════════════════════════════════════
//  NAVIGATION
// ════════════════════════════════════════════════════
function renderNav() {
  const el = document.getElementById('nav-links');
  el.innerHTML = '';
  const seenGroups = new Set();

  allSections.forEach(s => {
    if (s.hidden) return;
    if (s.id === 'main') return;
    if (!s.group) {
      const a = document.createElement('a');
      a.className = 'nav-item';
      a.textContent = s.label;
      a.href = sectionToUrl(s);
      if (curSection && curSection.id === s.id) a.classList.add('active');
      a.onclick = e => { e.preventDefault(); navigateTo(s.id); };
      el.appendChild(a);
    } else {
      if (!seenGroups.has(s.group)) {
        seenGroups.add(s.group);
        const isOpen = expandedGroup === s.group;
        const head = document.createElement('a');
        head.className = 'nav-item' + (isOpen ? ' group-open' : '');
        head.textContent = s.group;
        head.onclick = () => {
          expandedGroup = isOpen ? null : s.group;
          if (isOpen && curSection && curSection.group === s.group) curSection = null;
          if (!isOpen) {
            if (!curSection || curSection.group !== s.group) {
              curSection = null;
              const groupDesc = (MANIFEST.groups || {})[s.group];
              if (groupDesc) {
                document.getElementById('view-text').classList.remove('visible');
                document.getElementById('view-slide').classList.add('hidden');
                document.getElementById('topbar').classList.add('hidden');
                document.getElementById('nav-arrows').classList.add('hidden');
                document.getElementById('view-grid').classList.add('visible');
                document.getElementById('section-description').innerHTML = groupDesc.replace(/\n/g, '<br>');
                document.getElementById('grid-wrap').innerHTML = '';
              }
            }
          }
          renderNav();
          renderMain();
        };
        el.appendChild(head);
      }
      if (expandedGroup === s.group) {
        const a = document.createElement('a');
        a.className = 'nav-item sub';
        a.textContent = s.label;
        a.href = sectionToUrl(s);
        if (curSection && curSection.id === s.id) a.classList.add('active');
        a.onclick = e => { e.preventDefault(); navigateTo(s.id); };
        el.appendChild(a);
      }
    }
  });
}

function navigateTo(id) {
  const s = allSections.find(x => x.id === id);
  if (s && !isMobile()) history.pushState(null, '', sectionToUrl(s));
  selectSection(id);
}

function selectSection(id) {
  const s = allSections.find(x => x.id === id);
  if (!s) return;
  curSection = s;
  curPhotoIdx = 0;
  curPhotos = s.photos || (s.blocks ? (s.blocks.find(b => b.type === 'gallery') || {photos:[]}).photos : []);
  viewMode = 'grid';
  fsScale = 1; fsPanX = 0; fsPanY = 0;
  if (s.group) expandedGroup = s.group;
  renderNav();
  updateMobileShell();
  renderMain();
}

function goHome() {
  navigateTo('main');
}

window.addEventListener('popstate', () => {
  const id = urlToSectionId(window.location.pathname) || 'main';
  selectSection(id);
});

// ════════════════════════════════════════════════════
//  RENDER MAIN
// ════════════════════════════════════════════════════
function renderMain() {
  if (!curSection) return;
  const s = curSection;

  if (s.type === 'photos') {
    document.getElementById('view-text').classList.remove('visible');
    if (isMobile()) {
      s.blocks ? showRichSection() : showMobileFeed();
    } else {
      document.getElementById('topbar').classList.remove('hidden');
      document.getElementById('nav-arrows').classList.remove('hidden');
      if (viewMode === 'grid') { s.blocks ? showRichSection() : showGrid(); }
      else showSlide();
    }
  } else {
    document.getElementById('view-grid').classList.remove('visible');
    document.getElementById('view-slide').classList.add('hidden');
    document.getElementById('nav-arrows').classList.add('hidden');
    document.getElementById('topbar').classList.add('hidden');
    renderTextPage(s);
  }
}

// ════════════════════════════════════════════════════
//  RICH SECTION
// ════════════════════════════════════════════════════
function showRichSection() {
  document.getElementById('view-slide').classList.add('hidden');
  const vg = document.getElementById('view-grid');
  vg.classList.add('visible');
  document.getElementById('section-description').innerHTML = '';
  const wrap = document.getElementById('grid-wrap');
  wrap.innerHTML = '';
  wrap.classList.add('rich');

  (curSection.blocks || []).forEach(block => {
    if (block.type === 'text') {
      const div = document.createElement('div');
      div.className = 'rich-text-block';
      div.innerHTML = esc(block.content);
      wrap.appendChild(div);
    } else if (block.type === 'gallery') {
      const grid = document.createElement('div');
      grid.className = 'grid-wrap';
      block.photos.forEach((p, i) => {
        const div = document.createElement('div');
        div.className = 'grid-thumb';
        const cap = p.caption ? `<div class="grid-thumb-caption">${esc(p.caption)}</div>` : '';
        div.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.caption)}" loading="lazy">${cap}`;
        div.onclick = () => {
          curPhotos = block.photos;
          curPhotoIdx = i;
          if (isMobile()) openMobileFS(i);
          else setViewMode('slide');
        };
        grid.appendChild(div);
      });
      wrap.appendChild(grid);
    } else if (block.type === 'video') {
      const vwrap = document.createElement('div');
      vwrap.className = 'rich-video-block';
      const ytId = block.url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/)?.[1];
      if (ytId) {
        vwrap.innerHTML = `<img src="https://img.youtube.com/vi/${ytId}/maxresdefault.jpg" alt=""><div class="video-play-btn"></div>`;
        vwrap.onclick = () => {
          vwrap.innerHTML = `<iframe src="${esc(block.url)}?autoplay=1&modestbranding=1&rel=0" allowfullscreen allow="autoplay; fullscreen"></iframe>`;
          vwrap.onclick = null; vwrap.style.cursor = 'default';
        };
      } else {
        vwrap.innerHTML = `<iframe src="${esc(block.url)}" allowfullscreen allow="autoplay; fullscreen"></iframe>`;
      }
      wrap.appendChild(vwrap);
    }
  });
}

// ════════════════════════════════════════════════════
//  MOBILE FEED
// ════════════════════════════════════════════════════
function showMobileFeed() {
  document.getElementById('view-slide').classList.add('hidden');
  const vg = document.getElementById('view-grid');
  vg.classList.add('visible');
  document.getElementById('section-description').innerHTML = (curSection.description || '').replace(/\n/g, '<br>');
  const wrap = document.getElementById('grid-wrap');
  wrap.innerHTML = '';
  wrap.classList.remove('rich');

  curPhotos = curSection.photos || [];
  const photos = curPhotos;
  if (photos.length === 0) {
    wrap.innerHTML = '<div style="padding:40px;font-size:10px;color:var(--text-dim);letter-spacing:.08em;text-transform:uppercase">aucune image</div>';
    return;
  }

  photos.forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'grid-thumb';
    const cap = p.caption ? `<div class="grid-thumb-caption">${esc(p.caption)}</div>` : '';
    div.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.caption)}" loading="lazy">${cap}`;
    div.onclick = () => openMobileFS(i);
    wrap.appendChild(div);
  });
}

// ════════════════════════════════════════════════════
//  DESKTOP GRID / SLIDE
// ════════════════════════════════════════════════════
function showGrid() {
  document.getElementById('view-slide').classList.add('hidden');
  const vg = document.getElementById('view-grid');
  vg.classList.add('visible');
  document.getElementById('section-description').innerHTML = (curSection.description || '').replace(/\n/g, '<br>');
  const wrap = document.getElementById('grid-wrap');
  wrap.innerHTML = '';
  wrap.classList.remove('rich');

  const photos = curSection.photos || [];
  if (photos.length === 0) {
    wrap.innerHTML = '<div style="padding:40px;font-size:10px;color:var(--text-dim);letter-spacing:.08em;text-transform:uppercase">aucune image dans cette section</div>';
    return;
  }

  photos.forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'grid-thumb' + (i === curPhotoIdx ? ' active-thumb' : '');
    div.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.caption)}" loading="lazy">`;
    div.onclick = () => { curPhotoIdx = i; setViewMode('slide'); };
    wrap.appendChild(div);
  });

  updateCounter();
  document.getElementById('btn-grid').classList.add('active');
  document.getElementById('btn-slide').classList.remove('active');
}

function showSlide() {
  document.getElementById('view-grid').classList.remove('visible');
  const vs = document.getElementById('view-slide');
  vs.classList.remove('hidden');

  const photos = curPhotos;
  const p = photos[curPhotoIdx];

  const img = document.getElementById('slide-img');
  const ph = document.getElementById('slide-placeholder');
  const cap = document.getElementById('slide-caption');

  if (p && p.url) {
    img.classList.remove('loaded');
    img.src = p.url;
    img.style.display = 'block';
    img.onload = () => img.classList.add('loaded');
    ph.style.display = 'none';
    cap.textContent = p.caption || '';
  } else {
    img.style.display = 'none';
    ph.style.display = 'flex';
    ph.textContent = photos.length === 0 ? 'aucune image' : 'image manquante';
    cap.textContent = p ? (p.caption || '') : '';
  }

  updateCounter();
  document.getElementById('btn-slide').classList.add('active');
  document.getElementById('btn-grid').classList.remove('active');
}

function updateCounter() {
  document.getElementById('counter').textContent = `${curPhotoIdx + 1} / ${curPhotos.length || 1}`;
}

function setViewMode(mode) {
  viewMode = mode;
  if (!curSection || curSection.type !== 'photos') return;
  if (mode === 'grid') { curSection.blocks ? showRichSection() : showGrid(); }
  else showSlide();
}

function navigate(dir) {
  if (!curSection) return;
  if (curPhotos.length === 0) return;
  curPhotoIdx = (curPhotoIdx + dir + curPhotos.length) % curPhotos.length;
  if (viewMode === 'slide') showSlide();
  else {
    document.querySelectorAll('.grid-thumb').forEach((el, i) => {
      el.classList.toggle('active-thumb', i === curPhotoIdx);
    });
    updateCounter();
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeMobileFS(); }
});

// ════════════════════════════════════════════════════
//  TEXT PAGES
// ════════════════════════════════════════════════════
function renderTextPage(s) {
  const el = document.getElementById('view-text');
  el.classList.add('visible');

  if (s.type === 'info') {
    el.innerHTML = `<div class="text-section"><h2>Info</h2><p>${DATA.infoText}</p></div>`;
  } else if (s.type === 'contact') {
    el.innerHTML = `
      <div class="text-section">
        <h2>Contact</h2>
        <div class="cf-field"><label>Name *</label><input type="text" id="cf-name" placeholder="Your name"></div>
        <div class="cf-field"><label>Email *</label><input type="email" id="cf-email" placeholder="your@email.com"></div>
        <div class="cf-field"><label>Message *</label><textarea id="cf-msg" placeholder="Your message…"></textarea></div>
        <button class="cf-submit" onclick="submitContact()">Send</button>
        <p style="margin-top:24px;font-size:9.5px;color:var(--text-dim)">or directly: <a href="mailto:${esc(DATA.email)}" style="color:var(--text)">${esc(DATA.email)}</a></p>
      </div>`;
  } else if (s.type === 'links') {
    let html = '';
    DATA.links.forEach(sec => {
      html += `<div class="text-section"><h2>${esc(sec.section)}</h2>`;
      sec.items.forEach(it => {
        if (it.name && it.url) html += `<a class="ext" href="${esc(it.url)}" target="_blank">${esc(it.name)}</a>`;
      });
      html += '</div>';
    });
    el.innerHTML = html;
  }
}

function submitContact() {
  const n = document.getElementById('cf-name')?.value.trim();
  const e = document.getElementById('cf-email')?.value.trim();
  const m = document.getElementById('cf-msg')?.value.trim();
  if (!n || !e || !m) { alert('Please fill in all fields.'); return; }
  const s = encodeURIComponent('Message from ' + n);
  const b = encodeURIComponent(m + '\n\nFrom: ' + n + '\nEmail: ' + e);
  window.location.href = 'mailto:' + DATA.email + '?subject=' + s + '&body=' + b;
}

// ════════════════════════════════════════════════════
//  THEME
// ════════════════════════════════════════════════════
function toggleTheme() {
  document.body.classList.toggle('light');
  const isLight = document.body.classList.contains('light');
  document.getElementById('theme-btn').textContent = isLight ? 'light' : 'dark';
  localStorage.setItem('rc-theme', isLight ? 'light' : 'dark');
}

// ════════════════════════════════════════════════════
//  UTILS
// ════════════════════════════════════════════════════
function esc(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── KEYBOARD ──
document.addEventListener('keydown', e => {
  if (isMobile()) return;
  if (viewMode === 'slide') {
    if (e.key === 'ArrowLeft')  navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
    if (e.key === 'Escape')     setViewMode('grid');
  }
});

// ── GO ──
init();
</script>
</body>
</html>
