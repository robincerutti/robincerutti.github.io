---
import { readFileSync } from 'fs';

// ── helpers (build-time) ──────────────────────────────────────────
function sectionToSlug(s) {
  if (s.hidden) return null;
  if (!s.group) return s.id.toLowerCase().replace(/\s+/g, '-');
  const g = s.group.toLowerCase();
  const sub = s.id.slice(g.length + 1);
  return g + '/' + sub.toLowerCase().replace(/\s+/g, '-');
}

function getFirstPhoto(s) {
  if (s.photos && s.photos.length > 0) return s.photos[0].url;
  if (s.blocks) {
    for (const b of s.blocks) {
      if (b.type === 'gallery' && b.photos.length > 0) return b.photos[0].url;
    }
  }
  return null;
}

// ── static paths ──────────────────────────────────────────────────
export function getStaticPaths() {
  function _slug(s) {
    if (!s.group) return s.id.toLowerCase().replace(/\s+/g, '-');
    const g = s.group.toLowerCase();
    const sub = s.id.slice(g.length + 1);
    return g + '/' + sub.toLowerCase().replace(/\s+/g, '-');
  }

  const root = process.cwd();
  const manifest = JSON.parse(readFileSync(root + '/public/manifest.json', 'utf-8'));
  const data    = JSON.parse(readFileSync(root + '/public/data.json',    'utf-8'));

  const paths = [];
  for (const s of manifest.sections) {
    if (s.id === 'main') {
      paths.push({ params: { slug: undefined }, props: { section: s, manifest, data } });
      continue;
    }
    const slug = _slug(s);
    if (slug) paths.push({ params: { slug }, props: { section: s, manifest, data } });
  }
  for (const s of data.extraSections || []) {
    paths.push({ params: { slug: s.id }, props: { section: s, manifest, data } });
  }
  return paths;
}

// ── page props ────────────────────────────────────────────────────
const { section, manifest, data } = Astro.props;

const firstPhoto = getFirstPhoto(section);
const ogImage    = firstPhoto
  ? 'https://robincerutti.com/' + firstPhoto
  : 'https://robincerutti.github.io/photos/02-projects/010-mirror/01_-mirror%20-%20tornado%202024%20--.jpg';
const pageTitle  = 'ROBIN CERUTTI';
const pageDesc   = (section.description || '').replace(/\[video:[^\]]+\]/gi, '').trim()
  || `Robin Cerutti — ${section.label}. Photographer & Visual Artist. Totally real surrealism.`;
const canonicalUrl = section.id === 'main'
  ? 'https://robincerutti.com/'
  : `https://robincerutti.com/${sectionToSlug(section)}/`;

// All photos flat list (for structured data)
const allPhotos = section.photos || (section.blocks
  ? section.blocks.filter(b => b.type === 'gallery').flatMap(b => b.photos)
  : []);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{pageTitle}</title>
<meta name="description" content={pageDesc}>
<meta name="keywords" content="Robin Cerutti, photographer, visual artist, fine art photography, surrealism, Montreal, Canada, France">
<link rel="canonical" href={canonicalUrl}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDesc}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDesc}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:site" content="@robincerutti">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-MNJ4S6RDH6"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-MNJ4S6RDH6');
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital@0;1&display=swap" rel="stylesheet">
{allPhotos.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": `Robin Cerutti — ${section.label}`,
    "description": pageDesc,
    "url": canonicalUrl,
    "author": {
      "@type": "Person",
      "name": "Robin Cerutti",
      "url": "https://robincerutti.com"
    },
    "image": allPhotos.slice(0, 10).map(p => ({
      "@type": "ImageObject",
      "url": `https://robincerutti.com/${p.url}`,
      "name": p.caption || section.label
    }))
  })} />
)}
<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0e0e0e;
  --sidebar-w: 160px;
  --text: rgba(255,255,255,0.75);
  --text-dim: rgba(255,255,255,0.3);
  --text-active: rgba(255,255,255,0.95);
  --accent: rgba(255,255,255,0.12);
  --mono: 'Space Mono', monospace;
  --fs: 11px;
}

html, body {
  height: 100%; background: var(--bg); color: var(--text);
  font-family: var(--mono); font-size: var(--fs);
  transition: background .5s ease, color .5s ease;
}

/* ══ LAYOUT ══ */
#shell { display: flex; height: 100vh; overflow: hidden; }

/* ── SIDEBAR ── */
#sidebar {
  width: var(--sidebar-w); flex-shrink: 0;
  padding: 28px 20px 24px;
  display: flex; flex-direction: column; gap: 0;
  border-right: 1px solid rgba(255,255,255,0.06);
  overflow-y: auto; z-index: 10;
  transition: border-color .5s ease;
}

#site-name {
  font-size: 11px; font-weight: 400; letter-spacing: .08em;
  text-transform: uppercase; color: var(--text-active);
  margin-bottom: 28px; line-height: 1.4; cursor: pointer;
}

.nav-item {
  display: block; padding: 5px 0; font-size: 10px;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--text-dim); cursor: pointer; text-decoration: none;
  transition: color .15s; user-select: none;
}
.nav-item:hover { color: var(--text); }
.nav-item.active { color: var(--text-active); }
.nav-item.group-open { color: var(--text); }
.nav-item.sub { padding-left: 10px; font-size: 9.5px; color: var(--text-dim); }
.nav-item.sub:hover { color: var(--text); }
.nav-item.sub.active { color: var(--text-active); }

.nav-sep { height: 1px; background: rgba(255,255,255,0.06); margin: 14px 0; transition: background .5s ease; }

#sidebar-bottom { margin-top: auto; padding-top: 20px; }
#copyright { font-size: 8px; font-family: var(--mono); letter-spacing: .03em; color: var(--text); opacity: 1; padding: 4px 0 10px; white-space: nowrap; line-height: 1.4; }
.theme-toggle {
  background: none; border: none; color: var(--text-dim);
  cursor: pointer; font-size: 10px; padding: 4px 0; display: block;
  transition: color .3s; font-family: var(--mono);
  letter-spacing: .06em; text-transform: uppercase; opacity: 0.4;
}
.theme-toggle:hover { opacity: 0.8; }

/* ── MAIN AREA ── */
#main { flex: 1; overflow: hidden; position: relative; display: flex; flex-direction: column; }

/* ── TOP BAR ── */
#topbar {
  position: absolute; top: 0; left: 0; right: 0; z-index: 5;
  display: flex; align-items: center; gap: 16px;
  padding: 28px 20px 14px;
  font-size: 10px; color: var(--text-dim); letter-spacing: .05em;
}
#topbar.hidden { display: none; }

.view-toggle {
  background: none; border: none; color: var(--text-dim);
  cursor: pointer; font-size: 13px; padding: 2px 4px; line-height: 1;
  transition: color .15s;
}
.view-toggle:hover, .view-toggle.active { color: var(--text-active); }

#nav-arrows { display: flex; align-items: center; gap: 10px; }
.arrow-btn {
  background: none; border: none; color: var(--text-dim);
  cursor: pointer; font-size: 14px; padding: 0 4px; line-height: 1;
  transition: color .15s;
}
.arrow-btn:hover { color: var(--text-active); }
#counter { min-width: 50px; }
#key-hint { opacity: .4; font-style: italic; }

/* ══ SLIDESHOW VIEW ══ */
#view-slide {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 60px 32px 32px; overflow: hidden;
}
#view-slide.hidden { display: none; }

#slide-img-wrap {
  position: relative; max-width: 100%; max-height: 100%;
  display: flex; align-items: center; justify-content: center;
}

#slide-img {
  max-width: 100%; max-height: calc(100vh - 100px);
  object-fit: contain; display: block; user-select: none;
  opacity: 0; transition: opacity .3s ease;
}
#slide-img.loaded { opacity: 1; }

#slide-caption {
  position: absolute; bottom: -22px; left: 0;
  font-size: 9.5px; color: var(--text-dim);
  letter-spacing: .04em; font-style: italic;
}

.slide-placeholder {
  width: 640px; max-width: 100%; aspect-ratio: 3/2;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim); font-size: 10px; letter-spacing: .08em;
  text-transform: uppercase;
}

/* ══ GRID VIEW ══ */
#view-grid { flex: 1; overflow-y: auto; padding: 52px 16px 32px; display: none; }
#view-grid.visible { display: block; }

#section-description {
  font-size: 10px; color: var(--text-active);
  letter-spacing: .06em;
  margin-top: 1.6em; margin-bottom: 16px; line-height: 1.6;
  max-width: 480px;
  text-align: justify;
}
#section-description:empty { display: none; }

.grid-wrap {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 3px;
}

#grid-wrap.rich { display: block; }
.rich-text-block {
  font-size: 10px; color: var(--text-active);
  letter-spacing: .06em; line-height: 1.7;
  max-width: 480px; text-align: justify;
  margin: 20px 0 12px 0;
  white-space: pre-wrap;
}
.rich-gallery-label {
  font-size: 9px; color: var(--text-dim);
  letter-spacing: .12em; text-transform: uppercase;
  margin: 20px 0 6px 0;
}
#grid-wrap.rich .grid-wrap { margin-bottom: 4px; }
.rich-video-block {
  position: relative; width: 100%; padding-bottom: 56.25%;
  height: 0; margin: 20px 0; cursor: pointer;
  background: #000;
}
.rich-video-block iframe,
.rich-video-block img {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%; border: none; display: block;
  object-fit: cover;
}
.rich-video-block img { opacity: .7; transition: opacity .2s; }
.rich-video-block:hover img { opacity: .9; }
.video-play-btn {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 48px; height: 48px; border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
}
.video-play-btn::after {
  content: ''; display: block;
  width: 0; height: 0;
  border-top: 9px solid transparent;
  border-bottom: 9px solid transparent;
  border-left: 15px solid rgba(255,255,255,0.8);
  margin-left: 3px;
}

.grid-thumb {
  aspect-ratio: 1; overflow: hidden; cursor: pointer;
  position: relative; background: rgba(255,255,255,0.04);
}
.grid-thumb img {
  width: 100%; height: 100%; object-fit: cover;
  display: block; transition: opacity .2s;
}
.grid-thumb:hover img { opacity: .75; }
.grid-thumb.active-thumb::after {
  content: ''; position: absolute; inset: 0;
  outline: 2px solid rgba(255,255,255,0.5); outline-offset: -2px;
}

/* ══ TEXT PAGES ══ */
#view-text { flex: 1; overflow-y: auto; padding: 48px 56px; display: none; max-width: 600px; }
#view-text.visible { display: block; }

.text-section { margin-bottom: 40px; }
.text-section h2 {
  font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-dim); margin-bottom: 16px;
  padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.text-section p, .text-section a {
  font-size: 11px; color: var(--text); line-height: 1.9;
  text-decoration: none; display: block;
}
.text-section a:hover { color: var(--text-active); }
.text-section a.ext::after { content: ' →'; color: var(--text-dim); }

.cf-field { margin-bottom: 20px; }
.cf-field label { display: block; font-size: 9.5px; color: var(--text-dim); letter-spacing: .08em; margin-bottom: 7px; text-transform: uppercase; }
.cf-field input, .cf-field textarea {
  width: 100%; background: transparent;
  border: none; border-bottom: 1px solid rgba(255,255,255,0.15);
  color: var(--text-active); font-family: var(--mono); font-size: 11px;
  padding: 8px 0; outline: none; transition: border-color .2s;
}
.cf-field input:focus, .cf-field textarea:focus { border-color: rgba(255,255,255,0.5); }
.cf-field textarea { height: 100px; resize: none; }
.cf-submit {
  margin-top: 8px; padding: 9px 24px;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
  color: var(--text); font-family: var(--mono); font-size: 10px;
  letter-spacing: .08em; cursor: pointer; transition: background .2s;
}
.cf-submit:hover { background: rgba(255,255,255,0.14); }

/* ══ LIGHT MODE ══ */
body.light {
  --bg: #f8f8f6;
  --text: rgba(0,0,0,0.7);
  --text-dim: rgba(0,0,0,0.3);
  --text-active: rgba(0,0,0,0.9);
  --accent: rgba(0,0,0,0.07);
}
body.light #sidebar { border-right-color: rgba(0,0,0,0.08); }
body.light .nav-sep { background: rgba(0,0,0,0.07); }
body.light .grid-thumb { background: rgba(0,0,0,0.04); }
body.light .slide-placeholder { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.08); }
body.light .cf-field input, body.light .cf-field textarea { border-bottom-color: rgba(0,0,0,0.15); color: rgba(0,0,0,0.9); }
body.light .cf-field input:focus, body.light .cf-field textarea:focus { border-bottom-color: rgba(0,0,0,0.5); }
body.light .cf-submit { background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.15); color: rgba(0,0,0,0.8); }
body.light .cf-submit:hover { background: rgba(0,0,0,0.1); }
body.light .text-section h2 { border-bottom-color: rgba(0,0,0,0.07); }
body.light .view-toggle, body.light .arrow-btn { color: rgba(0,0,0,0.3); }
body.light .view-toggle:hover, body.light .view-toggle.active, body.light .arrow-btn:hover { color: rgba(0,0,0,0.9); }

/* ══ LOADING ══ */
#loading {
  position: fixed; inset: 0; display: flex;
  align-items: center; justify-content: center;
  background: var(--bg); z-index: 100;
  font-size: 10px; letter-spacing: .1em; color: var(--text-dim);
  text-transform: uppercase;
  transition: opacity .4s ease;
}
#loading.done { opacity: 0; pointer-events: none; }

#mobile-back { display: none; }

/* ══ MOBILE FULLSCREEN OVERLAY ══ */
#mobile-fs {
  display: none; position: fixed; inset: 0; z-index: 200;
  background: #000; overflow: hidden;
  touch-action: none;
}
#mobile-fs.open { display: block; }

.fs-slot {
  position: absolute; top: 0; left: 0;
  width: 100vw; height: 100vh;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.fs-slot img {
  max-width: 100%; max-height: 100vh;
  object-fit: contain; user-select: none;
  transform-origin: center center;
}

#mobile-fs-close {
  position: absolute; top: 0; right: 0;
  background: none; border: none;
  color: rgba(255,255,255,0.55); font-size: 18px;
  cursor: pointer; padding: 20px; z-index: 201;
  font-family: var(--mono); line-height: 1;
}

#mobile-fs-counter {
  position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
  font-size: 10px; color: rgba(255,255,255,0.3);
  font-family: var(--mono); letter-spacing: .06em; white-space: nowrap;
}
#mobile-fs-caption {
  position: absolute; bottom: 48px; left: 0; right: 0; text-align: center;
  font-size: 10px; color: rgba(255,255,255,0.95);
  letter-spacing: .06em;
  padding: 0 24px; pointer-events: none;
}
#mobile-fs-caption:empty { display: none; }
.grid-thumb-caption {
  font-size: 10px; color: var(--text-active);
  letter-spacing: .06em;
  padding: 6px 0 12px; line-height: 1.4;
}

/* ══ MOBILE LAYOUT ══ */
@media (max-width: 640px) {
  html, body { height: auto; overflow-y: auto; }
  #shell { flex-direction: column; height: auto; min-height: 100vh; overflow: visible; }
  #sidebar {
    width: 100%; border-right: none; overflow: visible;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 20px 20px 16px;
  }
  body.light #sidebar { border-bottom-color: rgba(0,0,0,0.07); }
  #site-name { margin-bottom: 16px; }
  .nav-item { font-size: 10px; padding: 4px 0; }
  .nav-item.sub { padding-left: 12px; }
  #main { overflow: visible; position: static; height: auto; flex: 1; }
  #topbar { display: none !important; }
  #mobile-back { display: none !important; }
  #view-slide { display: none !important; }
  #view-grid { flex: none; overflow: visible; padding: 0 0 60px; }
  .grid-wrap { grid-template-columns: 1fr; gap: 3px; }
  .grid-thumb { aspect-ratio: unset; }
  .grid-thumb img { height: auto; object-fit: fill; }
  #view-text { flex: none; overflow: visible; padding: 24px 20px 40px; max-width: 100%; }
}

/* ══ SEO SNAPSHOT — visually hidden but readable by crawlers ══ */
#seo-snapshot {
  position: absolute;
  width: 1px; height: 1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  pointer-events: none;
}
</style>
</head>
<body>

<div id="loading">chargement…</div>

<!-- Mobile fullscreen overlay -->
<div id="mobile-fs">
  <button id="mobile-fs-close" onclick="closeMobileFS()">✕</button>
  <div class="fs-slot" id="mobile-fs-slot-a"><img id="mobile-fs-img-a" alt=""></div>
  <div class="fs-slot" id="mobile-fs-slot-b"><img id="mobile-fs-img-b" alt=""></div>
  <div id="mobile-fs-caption"></div>
  <div id="mobile-fs-counter"></div>
</div>

<div id="shell">
  <nav id="sidebar">
    <div id="site-name" onclick="goHome()"></div>
    <div id="nav-links"></div>
    <div id="sidebar-bottom">
      <div class="nav-sep"></div>
      <div id="copyright"></div>
      <button class="theme-toggle" id="theme-btn" onclick="toggleTheme()" title="Toggle light/dark">dark</button>
    </div>
  </nav>

  <div id="main">
    <div id="mobile-back" onclick="goHome()">← menu</div>

    <div id="topbar" class="hidden">
      <button class="view-toggle" id="btn-grid" onclick="setViewMode('grid')" title="Grid view">⊞</button>
      <button class="view-toggle active" id="btn-slide" onclick="setViewMode('slide')" title="Slideshow">▭</button>
      <div id="nav-arrows" class="hidden">
        <button class="arrow-btn" onclick="navigate(-1)">‹</button>
        <span id="counter">1 / 1</span>
        <button class="arrow-btn" onclick="navigate(1)">›</button>
        <span id="key-hint">— flèches pour naviguer —</span>
      </div>
    </div>

    <div id="view-grid">
      <div id="section-description"></div>
      <div class="grid-wrap" id="grid-wrap"></div>
    </div>

    <div id="view-slide" class="hidden">
      <div id="slide-img-wrap">
        <div class="slide-placeholder" id="slide-placeholder">sélectionne une section</div>
